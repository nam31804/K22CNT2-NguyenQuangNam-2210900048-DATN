@model User
@using vpp_shop.Models
@{
    var address = ViewBag.DefaultAddress as UserAddress;
}

<div class="container mt-5">
    <div class="profile-card mx-auto">

        <h4 class="mb-4">Thông tin cá nhân</h4>

        <!-- FORM THÔNG TIN -->
        <form asp-action="UpdateProfile" method="post">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Họ tên</label>
                    <input asp-for="FullName" class="form-control form-control-sm" />
                </div>

                <div class="col-md-6 mb-3">
                    <label>Số điện thoại</label>
                    <input asp-for="Phone" class="form-control form-control-sm" />
                </div>
            </div>

            <div class="mb-4">
                <label>Email</label>
                <input asp-for="Email" class="form-control form-control-sm" readonly />
            </div>

            <button type="submit" class="btn btn-primary btn-sm px-4">
                Lưu thay đổi
            </button>
        </form>

        <hr class="my-4" />

       
       

    </div>
</div>
