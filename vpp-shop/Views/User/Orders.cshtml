@model List<vpp_shop.Models.Order>

<h3 class="mb-3">Đơn hàng của tôi</h3>

<div class="order-filter">
    <a asp-action="Orders"
       asp-route-type="pending"
       class="@(ViewBag.Type == "pending" || ViewBag.Type == null ? "active" : "")">
        Chưa giao
    </a>

    <a asp-action="Orders"
       asp-route-type="completed"
       class="@(ViewBag.Type == "completed" ? "active" : "")">
        Hoàn thành
    </a>

    <a asp-action="Orders"
       asp-route-type="cancelled"
       class="@(ViewBag.Type == "cancelled" ? "active" : "")">
        Đã huỷ
    </a>
</div>


@if (!Model.Any())
{
    <p>Bạn chưa có đơn hàng nào.</p>
}
else
{
    <table class="table order-table align-middle">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Sản phẩm</th>
                <th>Tổng tiền</th>
                <th>Thanh toán</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>
                        <a href="javascript:void(0)"
                           onclick="viewOrder(@o.Id)"
                           class="fw-bold text-decoration-none">
                            #@o.Id
                        </a>
                    </td>


                    <td>
                        @o.CreatedAt?.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <!-- SẢN PHẨM -->
                    <td>
                        @foreach (var item in o.OrderItems)
                        {
                            <div class="d-flex gap-2 mb-2 align-items-center">
                                <img src="~/images/products/@item.Product.Image"
                                     class="order-product-img" />

                                <div>
                                    <div>@item.Product.Name</div>
                                    <small class="text-muted">
                                        SL: @item.Quantity × @item.Price.ToString("N0") đ
                                    </small>
                                </div>
                            </div>
                        }
                    </td>

                    <td class="text-danger fw-bold">
                        @o.TotalMoney.ToString("N0") đ
                    </td>

                    <td>@o.PaymentMethod</td>

                    <td>
                        <span class="badge status-@o.Status.ToLower()">
                            @o.Status
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary"
                                onclick="viewOrder(@o.Id)">
                            Xem
                        </button>
                    </td>
                </tr>
            

            }
        </tbody>
    </table>

    <!-- PHÂN TRANG -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="order-pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                if (i == ViewBag.CurrentPage)
                {
                    <span class="page-number active">@i</span>
                }
                else
                {
                    <a class="page-number"
                       asp-action="Orders"
                       asp-route-type="@ViewBag.Type"
                       asp-route-page="@i">
                        @i
                    </a>
                }
            }
        </div>
    }

}
<div class="modal fade" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết đơn hàng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="orderDetailContent">
                <!-- JS render -->
            </div>
        </div>
    </div>
</div>
<script>
    function viewOrder(orderId) {
        fetch(`/User/GetOrderDetail?id=${orderId}`)
            .then(res => res.json())
            .then(data => {

                let html = `
                    <p><b>Người nhận:</b> ${data.shippingName}</p>
                    <p><b>SĐT:</b> ${data.shippingPhone}</p>
                    <p><b>Địa chỉ:</b> ${data.shippingAddress}</p>
                    <p><b>Thanh toán:</b> ${data.paymentMethod}</p>
                    <p><b>Trạng thái:</b> ${data.status}</p>
                    <hr>
                `;

                data.items.forEach(i => {
                    html += `
                    <div class="d-flex gap-3 mb-2 align-items-center">
                        <img src="/images/products/${i.image}" width="60">
                        <div>
                            <div>${i.name}</div>
                            <small>SL: ${i.quantity} × ${i.price.toLocaleString()} đ</small>
                        </div>
                    </div>`;
                });

                if (data.status === "PENDING" || data.status === "PAID") {
                    html += `
                        <hr>
                        <button class="btn btn-danger"
                            onclick="cancelOrder(${data.id})">
                            Huỷ đơn hàng
                        </button>
                    `;
                }

                document.getElementById("orderDetailContent").innerHTML = html;
                new bootstrap.Modal(document.getElementById("orderDetailModal")).show();
            });
    }

    function cancelOrder(orderId) {
        if (!confirm("Bạn chắc chắn muốn huỷ đơn này?")) return;

        fetch('/User/CancelOrderAjax', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: `orderId=${orderId}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert("Huỷ đơn thành công!");
                location.reload();
            } else {
                alert("Không thể huỷ đơn này!");
            }
        });
    }
</script>
