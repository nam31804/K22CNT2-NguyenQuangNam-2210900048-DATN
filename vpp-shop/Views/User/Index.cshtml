@model User

<div class="container text-center mt-5">

    <div class="mb-4">
        <i class="bi bi-person-circle" style="font-size:60px;color:#555"></i>
        <h4 class="mt-2">@Model.FullName</h4>
        <p class="text-muted">@Model.Email</p>
    </div>

    <!-- SỐ DƯ VÍ -->
    <div class="wallet-summary mx-auto mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <span>Số dư ví</span>
            <span class="fw-bold text-success fs-5">
                @(ViewBag.Balance.ToString("N0")) đ
            </span>
        </div>

        <a class="btn btn-success w-100 mt-3">
            Nạp tiền vào ví
        </a>
    </div>

    <hr class="my-4" />

    <!-- MENU USER -->
    <div class="user-menu mx-auto text-start">
        <a asp-action="Profile">Thông tin cá nhân</a>
        <a asp-action="Orders">Đơn hàng của tôi</a>
        <a asp-action="Wallet">Ví của tôi</a>
        <a asp-action="ChangePassword">Đổi mật khẩu</a>
    </div>

</div>
